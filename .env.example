# Copy to .env.local to point the development proxy at other services.
# The browser always calls /lifewatch-api and /ltser-api; Vite forwards them here.
LIFEWATCH_API_URL=http://127.0.0.1:8000
LTSER_API_URL=http://127.0.0.1:8001/api/v1

# Dev server address. By default it listens on 127.0.0.1:5173. When PORT is set (hosted workspaces
# such as v0 or Codespaces set it), it listens on 0.0.0.0 and accepts the workspace's domain.
# HOST=0.0.0.0
# PORT=5173
