# LifeWatch România behind nginx: one origin for the public site, the LTSER Explorer and both APIs.
#
# The browser only talks to this server, so the APIs need no CORS settings.
# The prefixes match the defaults in public/runtime-config.js and the Vite dev proxy.
# Build first, from the repository root: npm ci && npm run build  (output in dist/).
# Optional: SITE_ORIGIN=https://lifewatch.ro npm run build  also writes dist/sitemap.xml.
#
# Layout of dist/:
#   index.html, despre/index.html, infrastructura/braila/index.html ...  prerendered site pages
#   404.html                                                             page for unknown paths
#   explorator/index.html                                                the explorer (hash routing)
#
# Copy to /etc/nginx/sites-available/ltser, adjust server_name, paths and upstream ports,
# then: ln -s ../sites-available/ltser /etc/nginx/sites-enabled/ && nginx -t && systemctl reload nginx

server {
    listen 80;
    server_name ltser.example.ro;

    root /srv/ltser/dist;
    index index.html;

    # Public site: every page is a prerendered file, /despre/ is served from /despre/index.html.
    location / {
        try_files $uri $uri/ =404;
    }
    error_page 404 /404.html;

    # The explorer routes after "#", so all of it is one page.
    location /explorator/ {
        try_files $uri $uri/ /explorator/index.html;
    }

    # Pages and runtime-config.js change on every deploy; let browsers revalidate them.
    location ~* \.html$ {
        add_header Cache-Control "no-cache";
    }
    location = /runtime-config.js {
        add_header Cache-Control "no-cache";
    }

    # Vite puts a content hash in every file name under /assets/, so they never change.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /data/ {
        expires 1h;
        add_header Cache-Control "public";
    }

    # LifeWatch FastAPI (github.com/GabrielMajeri/lifewatch-romania), e.g. `fastapi run --port 8000`.
    # "^~" keeps regex locations from catching API paths.
    location ^~ /lifewatch-api/ {
        proxy_pass http://127.0.0.1:8000/;
        proxy_http_version 1.1;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        # Seven day windows of raw data can take a while and weigh several megabytes.
        proxy_read_timeout 120s;
    }

    # LTSER API (docs/API_CONTRACT.md), including /media/ for photos and camera images.
    location ^~ /ltser-api/ {
        proxy_pass http://127.0.0.1:8001/api/v1/;
        proxy_http_version 1.1;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 120s;
    }

    gzip on;
    gzip_types text/css text/javascript application/javascript application/json application/geo+json image/svg+xml;
    gzip_min_length 1024;
}
